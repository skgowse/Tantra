# =====================================================================
# LEGAL TANTRA - ENVIRONMENT CONFIGURATION EXAMPLE
# =====================================================================

# Database configuration: Defaults to local zero-dependency SQLite
DATABASE_URL=sqlite:///./legaltantra.db

# App Environment (development, production)
ENVIRONMENT=development

# Optional AI Providers (If left blank, system runs safe deterministic fallback)
GEMINI_API_KEY=
OPENAI_API_KEY=

# External API Timeout (Seconds)
AI_REQUEST_TIMEOUT=12

# Optional Frontend API Base URL (for containerized or remote deployments)
VITE_API_BASE=http://localhost:8000/api
